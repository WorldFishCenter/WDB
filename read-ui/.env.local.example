# Where the read UI's server-side proxy (app/api/answer) forwards questions.
# This is the Phase-A1 FastAPI from `uv run uvicorn wdb_api.app:app` (default port 8000).
# Copy to `.env.local` to override. Local only — never a deployed URL.
WDB_API_URL=http://127.0.0.1:8000

# Root of the KNOWLEDGE BASE, used by app/api/source to open a citation's source note/doc
# (read-only, text files only, path-sandboxed). Citation paths are KB-relative, so this is the
# knowledge base — not the repo root. Defaults to ../knowledge_base.
# WDB_KB=/Users/you/path/to/your-knowledge-base
