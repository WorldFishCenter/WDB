# Graphify local-only files (README Section 7) — machine-specific, break when shared.
# Keep comments on their own lines: an inline "# ..." becomes part of the pattern.
# manifest.json + cache/stat-index.json are mtime/path-based (invalid after clone);
# cost.json is local token tracking; the .graphify_* dotfiles are transient pipeline
# scratch (detect/extract/analysis/labels/etc.) plus machine-local absolute paths
# (_root/_python). They are rebuilt on every run and must never be committed.
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/cache/stat-index.json
graphify-out/.graphify_*
# Dated snapshot folders graphify auto-creates when it backs up a curated graph
# before overwriting it (e.g. graphify-out/2026-06-03/) — local backups, not shared.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# The content-hashed cache (cache/ast, cache/semantic) IS committed so teammates skip
# re-extraction. To keep the repo small instead, ignore the whole cache: uncomment below.
# graphify-out/cache/

# Ingestion service local state — the workflow DB + staged uploads (design §8: workflow state
# lives in a database; binaries are staged before sign-off). Machine-local, never committed.
wdb_ingest/_state/
wdb_ingest/_staging/

# OS / editor cruft
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
# Build artifacts (uv build / setuptools — the container-prep step in RUNNING.md)
build/
dist/

# Mode B passage index — a regenerable artifact (rebuild with `python -m mode_b --ingest`),
# never committed (keeps the PR diff code + tests; same stance as a re-derived graph).
mode_b/.index/

# docs/ holds local-only POC design docs (untracked). Exclude its contents but keep
# the dir traversable so the negation below can re-include the one tracked deliverable.
/docs/*
!/docs/production-stack-design.md
!/docs/ingestion-pipeline-design.md
!/docs/model-cost-strategy.md
/proof
/proof_c
/proof_a

# model_eval/ — throwaway model-evaluation experiment (like proof_a/proof_c). The
# curated deliverable (harness + FINDINGS.md + results/ + drafts) is committed so the
# PR into feat-rag has a real diff; only the regenerable byproducts are ignored.
model_eval/raw/
model_eval/__pycache__/
model_eval/.venv/

.env
/civ-kb
commands