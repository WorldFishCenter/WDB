{"nodes": [{"id": "data_harmonization_idhf_diagnostic_assessment", "label": "Diagnostic Assessment Phase", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a72.3 / \u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_idhf_design_standardization", "label": "Design and Standardization Phase", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a72.3 / \u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_idhf_implementation_sustainability", "label": "Implementation and Sustainability Phase", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a72.3 / \u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_minimum_variable_set", "label": "Minimum Set of Standardized Variables", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_thematic_domain_spatial_temporal", "label": "Domain 1: Spatial and Temporal Reference", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_thematic_domain_fishing_effort", "label": "Domain 2: Fishing Effort", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_thematic_domain_catch_composition", "label": "Domain 3: Catch Composition", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_thematic_domain_socioeconomic_environmental", "label": "Domain 4: Socio-economic and Environmental Context", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a74.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_diagnostic_survey", "label": "Participatory Diagnostic Survey of Data Collection Practices", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a73", "source_url": "https://airtable.com/appBD5R0M2x6UYVVX/pagfTu86RMBrZg4VN/form", "captured_at": null, "author": null, "contributor": null, "rationale": "Maps what entities currently measure, how they define variables, and which tools/formats they use BEFORE prescribing a fixed minimum set, so the framework is grounded in operational realities rather than imposed top-down."}, {"id": "data_harmonization_airtable_form", "label": "Airtable Diagnostic Survey Form", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a73.2", "source_url": "https://airtable.com/appBD5R0M2x6UYVVX/pagfTu86RMBrZg4VN/form", "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_terms_variable_standardization", "label": "Terms/Variable Standardization", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77 / Slide: Terms/variables standardisation", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Different organizations use divergent labels for the same concept (Area vs Landing site vs Region; Monofilament Nets vs Gillnets; Linha de mao vs Handlines; Swahili vs English), so common definitions and ontology mappings are needed for collections to 'speak the same language'."}, {"id": "data_harmonization_taxonomic_resolution_heterogeneity", "label": "Species List & Taxonomic Resolution Heterogeneity", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "Slide: Different Species Lists", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Organizations record species at species-level vs mixed (species/genus) resolution and under many local names (e.g., Sardina pilchardus = Pilchard / Sardine / Sardinha), resolved by FAO 3-alpha codes (PIL), shared photo guides, and enumerator training."}, {"id": "data_harmonization_digital_data_collection_requirements", "label": "Functional Requirements for Electronic Data Collection Tools", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tool-agnostic requirements (offline capture, built-in validation, controlled picklists, GPS capture, open export formats, multilingual, open-source, API/middleware, photo capture) avoid mandating one platform while ensuring data quality and interoperability across the diversity of tools already in use."}, {"id": "data_harmonization_paper_vs_digital", "label": "Paper vs. Digital Data Collection", "file_type": "rationale", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a76.1 / Slide: Paper vs. Digital forms", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paper entails manual transcription errors, weeks/months of delay, data stuck in local offices, and no real-time validation; digital allows direct device entry, immediate sync+backup, built-in validation, and automatic export into analysis pipelines. 88% of institutions already use digital platforms, signalling readiness for a coordinated transition."}, {"id": "data_harmonization_centralized_data_pipeline", "label": "Centralized Tool-Agnostic Data Pipeline", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a76.3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Accepts data from multiple collection platforms and applies standardized transformation, validation, and formatting before ingestion into a central/regional repository, so diverse tools can converge to a common standard at the aggregation level."}, {"id": "data_harmonization_standardized_sampling_methodologies", "label": "Standardized Sampling Methodologies", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardizing variables alone is insufficient if sampling designs are incompatible; principles cover sampling frames, stratification, temporal/spatial coverage, raising procedures, and QA/QC so data from different institutions can be aggregated."}, {"id": "data_harmonization_raising_procedures", "label": "Raising / Scaling Procedures for Total Estimates", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a74.3 / \u00a75.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fishery-level census data (active fishers, number of boats) provide denominators to raise sample-based catch/effort to population totals; standardized landing-site metadata with coordinates enables spatial aggregation."}, {"id": "data_harmonization_regional_sop_manual", "label": "Regional Standard Operating Procedure (SOP) Manual", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a75.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_regional_data_dictionary", "label": "Regional Data Dictionary", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.3 / \u00a78.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Co-created with SWIOFC and WGDS, it defines core variables, metadata, classification systems, and standardized terms (with AQFO URI mappings as a medium-term goal) so all institutions work from an aligned vocabulary; maintained as a living document."}, {"id": "data_harmonization_data_governance", "label": "Data Governance & Institutional Arrangements", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a78", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommends legally binding data-sharing agreements (access levels, ownership, custodianship), and a regional data governance board potentially under SWIOFC, with national experts nominated by member countries linking regional governance to national implementation nodes."}, {"id": "data_harmonization_wgds", "label": "Working Group on Data Sharing (WGDS)", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a73.3 / \u00a75.2 / \u00a78.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_iso_8601", "label": "ISO 8601 Date/Time Standard", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_harmonization_implementation_roadmap", "label": "Phased Implementation Roadmap (2026-2030)", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six phases: Diagnostic (Q4 2026-Q1 2027); Standardization (Q2-Q3 2027); Pilot testing in Kenya/Mozambique/Zanzibar (Q3 2027-Q2 2028); Evaluation (Q3 2028); Regional rollout to SWIOFC member states (Q4 2028-Q4 2029); Sustained operation (2030+) with sustainable financing."}, {"id": "shared_kenya", "label": "Kenya", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_zanzibar", "label": "Zanzibar", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_mozambique", "label": "Mozambique", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a79", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_fair_ai_ready_data", "label": "FAIR / AI-ready Data", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_fao_asfis", "label": "FAO ASFIS & 3-alpha Species Codes", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_fao_gaul", "label": "FAO GAUL Admin Units", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_fao_isscfg", "label": "FAO ISSCFG Fishing Gear Classification", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.2 / FAO Technical Paper No. 672", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "shared_aquatic_food_ontology", "label": "Aquatic Food Ontology (AQFO)", "file_type": "concept", "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.3", "source_url": "http://w3id.org/aqfo/", "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "data_harmonization_hub", "target": "shared_fao_asfis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "graphify-out/converted/Technical_Guidelines_SSF_Data_Harmonization_WIO_8f7e1b7e.md", "source_location": "\u00a77.2", "weight": 1.0}, {"source": "data_harmoniz