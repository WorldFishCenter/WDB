{"nodes": [{"id": "peskas_zanzibar_validated_trips_zanzibar_validated_trips", "label": "Zanzibar Validated Trips dataset", "file_type": "document", "source_file": "peskas/zanzibar_validated_trips_dict.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "summary": "Validated small-scale fishery catch/effort records from Zanzibar (Unguja and Pemba islands, Tanzania), produced by the Peskas monitoring system. Grain: one row = one catch item of a fishing trip (~1.57 rows per trip_id); trip-level fields (location, gear, vessel, effort, trip totals) repeat across a trip's catch rows while per-catch detail (taxon, scientific_name, length_cm, catch_kg) varies row to row. Locations coded with FAO GAUL admin layers and catches with scientific names per the WIO SSF data-harmonization conventions."}], "edges": [{"source": "peskas_zanzibar_validated_trips_zanzibar_validated_trips", "target": "peskas_hub", "relation": "part_of", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "peskas/zanzibar_validated_trips_dict.md", "source_location": null, "weight": 1.0}, {"source": "peskas_zanzibar_validated_trips_zanzibar_validated_trips", "target": "peskas_validation_engine", "relation": "part_of", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "peskas/zanzibar_validated_trips_dict.md", "source_location": null, "weight": 1.0}, {"source": "peskas_zanzibar_validated_trips_zanzibar_validated_trips", "target": "peskas_validated_trips_catch_effort_record", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "peskas/zanzibar_validated_trips_dict.md", "source_location": null, "weight": 1.0}, {"source": "peskas_zanzibar_validated_trips_zanzibar_validated_trips", "target": "shared_zanzibar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "peskas/zanzibar_validated_trips_dict.md", "source_location": null, "we